{
  "name": "fit-doctor",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @fit-doctor/core && npm run build -w @fit-doctor/cli && npm run build -w @fit-doctor/web"
  },
  "engines": {
    "node": ">=22"
  }
}
