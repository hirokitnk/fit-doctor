{
  "name": "@fit-doctor/core",
  "version": "0.0.0",
  "description": "Zero-dependency, byte-level FIT file scanner and repair toolkit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:profile": "node scripts/gen-profile.mjs"
  },
  "devDependencies": {
    "@fit-doctor/fixtures": "*",
    "@garmin/fitsdk": "^21.218.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
